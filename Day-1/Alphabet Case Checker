#include<iostream>
using namespace std;

int main() {
    char ch;

    cout << "Enter a character: ";
    cin >> ch;

    if (ch >= 'A' && ch <= 'Z') {
        cout << "Uppercase Alphabet" << endl;
    }
    else if (ch >= 'a' && ch <= 'z') {
        cout << "Lowercase Alphabet" << endl;
    }
    else {
        cout << "Not an Alphabet" << endl;
    }

    return 0;
}
