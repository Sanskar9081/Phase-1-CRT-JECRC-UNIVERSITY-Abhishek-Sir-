// sum and average of 3 numbers 
// take input from the users and find sum and average 
#include<iostream>
using namespace std;

int main() {
    int a, b, c, sum;
    float avergae;
    
    cin >> a >> b >> c;
    sum = a + b + c;
    avergae = sum / 3.0;
    
    cout << sum << endl;
    cout << avergae << endl;
    
    return 0;
}
